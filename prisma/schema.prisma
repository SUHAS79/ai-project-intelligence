// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String          @id @default(cuid())
  fullName             String
  email                String          @unique
  password             String
  role                 String          @default("developer") // manager | developer | senior_developer | other
  status               String          @default("active")    // active | inactive
  initials             String
  createdAt            DateTime        @default(now())
  lastLogin            DateTime?
  projectMemberships   ProjectMember[]
  assignedTasks        Task[]          @relation("TaskAssignee")
  reviewedTasks        Task[]          @relation("TaskReviewer")
  createdEscalations   Escalation[]    @relation("EscalationCreator")
  respondedEscalations Escalation[]    @relation("EscalationResponder")
  availability         Availability[]
  createdMeetings      Meeting[]       @relation("MeetingCreator")
  participatingIn      Meeting[]       @relation("MeetingParticipant")
  taskComments         TaskComment[]
  projectMessages      ProjectMessage[]
  notifications        Notification[]
  createdTemplates     ProjectTemplate[] @relation("TemplateCreator")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // task_assigned | task_reassigned | task_status_changed | task_submitted_for_review | task_approved | task_rejected | escalation_received | escalation_responded | escalation_resolved | meeting_created | project_assigned
  title     String
  body      String
  link      String?  // relative URL to navigate to
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Availability {
  id        String  @id @default(cuid())
  userId    String?                       // null = company-wide holiday
  startDate String                        // YYYY-MM-DD
  endDate   String                        // YYYY-MM-DD (same as startDate for single days)
  type      String  @default("vacation")  // holiday | vacation | sick | wfh | partial
  note      String?
  approved  Boolean @default(false)       // auto-approved for sick/wfh/holiday; pending for vacation

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      String          @default("ACTIVE")
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks        Task[]
  risks        Risk[]
  members      ProjectMember[]
  escalations  Escalation[]
  meetings     Meeting[]
  messages     ProjectMessage[]
  activityLogs ActivityLog[]
}

model ActivityLog {
  id          String   @id @default(cuid())
  projectId   String
  entityType  String   // task | escalation | meeting | member | project
  entityId    String   // ID of the entity being acted upon
  entityTitle String   // snapshot of entity name at event time
  action      String   // created | assigned | reassigned | status_changed | submitted_for_review | approved | rejected | reopened | responded | resolved | scheduled | member_added | member_removed
  actorId     String?  // null for system events
  actorName   String   // snapshot of actor full name
  actorRole   String   // snapshot of actor role at event time
  details     String   // full human-readable sentence describing what happened
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Meeting {
  id            String    @id @default(cuid())
  title         String
  projectId     String?
  meetingType   String    @default("team")         // team | individual
  participantId String?
  roomName      String    @unique                  // used to form meet.jit.si/{roomName}
  scheduledAt   DateTime?
  createdById   String
  status        String    @default("scheduled")    // scheduled | active | ended
  createdAt     DateTime  @default(now())

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User     @relation("MeetingCreator",     fields: [createdById],   references: [id], onDelete: Cascade)
  participant User?    @relation("MeetingParticipant", fields: [participantId], references: [id], onDelete: SetNull)
}

model Task {
  id                   String    @id @default(cuid())
  projectId            String
  title                String
  description          String?
  status               String    @default("TODO") // TODO | IN_PROGRESS | BLOCKED | IN_REVIEW | DONE
  priority             String    @default("MEDIUM")
  owner                String?
  assignedToId         String?
  // Effort estimation fields
  estimatedHours       Float?
  actualHours          Float?
  // Review workflow fields
  reviewStatus         String?   // PENDING | APPROVED | REJECTED
  workSummary          String?
  rejectionReason      String?
  reviewedById         String?
  reviewedAt           DateTime?
  submittedForReviewAt DateTime?
  startDate            DateTime
  endDate              DateTime
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?            @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedBy   User?            @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  dependsOn    TaskDependency[] @relation("dependent")
  dependedOnBy TaskDependency[] @relation("dependency")
  activities   TaskActivity[]
  escalations  Escalation[]
  comments     TaskComment[]
}

model TaskComment {
  id           String   @id @default(cuid())
  taskId       String
  userId       String
  userFullName String
  userRole     String
  userInitials String
  body         String
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectMessage {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  userFullName String
  userRole     String
  userInitials String
  body         String
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Escalation {
  id            String    @id @default(cuid())
  projectId     String
  taskId        String?
  createdById   String
  message       String
  status        String    @default("OPEN") // OPEN | RESPONDED | RESOLVED
  targetRole    String    @default("manager") // manager | senior_developer | both
  response      String?
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy   User     @relation("EscalationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  respondedBy User?    @relation("EscalationResponder", fields: [respondedById], references: [id], onDelete: SetNull)
}

model TaskActivity {
  id           String   @id @default(cuid())
  taskId       String
  userId       String
  userFullName String
  action       String   // submitted_for_review | approved | rejected | status_changed | reopened
  details      String?
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskDependency {
  id           String @id @default(cuid())
  dependentId  String
  dependencyId String

  dependent  Task @relation("dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependency Task @relation("dependency", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@unique([dependentId, dependencyId])
}

model ProjectTemplate {
  id           String         @id @default(cuid())
  name         String
  description  String?
  durationDays Int                             // hint for end date when applying
  createdById  String
  createdAt    DateTime       @default(now())
  tasks        TemplateTask[]
  risks        TemplateRisk[]
  createdBy    User           @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
}

model TemplateTask {
  id             String          @id @default(cuid())
  templateId     String
  title          String
  description    String?
  priority       String          @default("MEDIUM")
  estimatedHours Float?
  startDayOffset Int             @default(0)   // days from project startDate
  durationDays   Int             @default(7)   // task duration in days
  template       ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model TemplateRisk {
  id          String          @id @default(cuid())
  templateId  String
  title       String
  description String?
  probability String          @default("MEDIUM")
  impact      String          @default("MEDIUM")
  mitigation  String?
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Risk {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  probability String   @default("MEDIUM")
  impact      String   @default("MEDIUM")
  mitigation  String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
