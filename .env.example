# ══════════════════════════════════════════════════════════════
# NAMO — Environment Variable Reference
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# See DEPLOYMENT.md for full setup instructions.
# ══════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ────────────────────────────────────────
# Local dev:  file:./dev.db
# Turso:      libsql://<db-name>-<org>.turso.io
DATABASE_URL="file:./dev.db"

# Turso auth token (leave blank for local file, required for Turso)
DATABASE_AUTH_TOKEN=""

# ── Auth (REQUIRED in production) ─────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# ── Email — Resend (optional) ──────────────────────────────────
# Emails are skipped silently when this is not set.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="NAMO <noreply@yourdomain.com>"

# ── App URL (recommended) ──────────────────────────────────────
# Used in email CTA links. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
